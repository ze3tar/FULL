<?xml version="1.0"?>
<package format="3">
  <name>apf_rrt_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 bridges for APF-RRT planners and waypoint exporters.</description>
  <maintainer email="maintainers@example.com">FULL maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

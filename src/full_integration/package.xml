<?xml version="1.0"?>
<package format="3">
  <name>full_integration</name>
  <version>0.0.0</version>
  <description>PPO-based trajectory refinement service for RM65.</description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>ament_cmake_python</build_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>trajectory_msgs</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>torch</exec_depend>
  <exec_depend>numpy</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
